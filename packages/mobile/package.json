{
  "name": "@skype-clone/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "React Native mobile application for Skype Clone",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace SkypeClone.xcworkspace -scheme SkypeClone -configuration Release -sdk iphoneos -archivePath build/SkypeClone.xcarchive archive",
    "clean": "cd android && ./gradlew clean && cd ../ios && rm -rf build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@react-navigation/stack": "^7.10.24",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "react": "18.2.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-image-picker": "^8.2.1",
    "react-native-permissions": "^5.6.1",
    "react-native-push-notification": "^8.1.1",
    "socket.io-client": "^4.7.2",
    "@skype-clone/shared": "*",
    "axios": "^1.5.0",
    "jwt-decode": "^4.0.0",
    "react-native-elements": "^3.4.3",
    "react-native-paper": "^5.10.4",
    "react-native-modal": "^13.0.1",
    "react-native-uuid": "^2.0.1",
    "react-native-get-random-values": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^8.0.5",
    "@babel/runtime": "^8.0.5",
    "@react-native/eslint-config": "^0.87.1",
    "@react-native/metro-config": "^0.87.1",
    "@tsconfig/react-native/tsconfig.json": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.3.0",
    "typescript": "^4.8.4",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0"
  },
  "engines": {
    "node": ">=16"
  }
}
